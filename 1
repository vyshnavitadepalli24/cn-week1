#include<stdio.h>
int main()
{
    char data[50],stuff[100];
    int i,j=0,count=0;
    scanf("%s",data);
    for(i=0;data[i]!='\0';i++)
    {
        stuff[j++]=data[i];
        if(data[i]=='1')
        {
            count++;
            if(count==5)
            {
                if(data[i+1]=='1')
                {stuff[j++]='0';
                count=0;
                }
            }
        }
        else
        {
            count=0;
        }
    }
    stuff[j]='\0';
    printf("Your stuffing data is:%s",stuff);
    return 0;
}
